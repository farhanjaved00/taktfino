---
import SimpleToolPage from '../../components/SimpleToolPage.astro';
import { SITE } from '../../config/site';
import { BUILD_TODAY } from '../../lib/build';
import { formatISO, addDays } from '../../lib/dates';
import { CATEGORIES } from '../../lib/links';
import Icon from '../../components/Icon.astro';
---
<SimpleToolPage
  title={`Countdown Timer to Any Date — Days, Hours, Minutes | ${SITE.name}`}
  description="Create a live countdown to any date and time — birthdays, trips, deadlines, launches. Share it with a link or add it to your calendar."
  h1="Countdown to any date"
  intro="Name your event, pick a date and time, and share the live countdown with a link."
  path="/countdown/" og="/og/countdown.png" appName="Countdown timer"
  crumbs={[{ name: 'Countdowns', path: CATEGORIES.countdowns.path }, { name: 'Countdown timer', path: '/countdown/' }]}
  related={['days-until', 'hours-from-now', 'days-from-today', 'date-duration-calculator']}
  faq={[
    { q: 'Can I share my countdown?', a: 'Yes. Click “Copy share link” — the event name, date and time are saved in the link, so anyone who opens it sees the same countdown in their own time zone.' },
    { q: 'Which time zone does the countdown use?', a: 'Your device’s time zone. A shared link stores the exact moment, so viewers in other time zones count down to the same instant.' },
    { q: 'Does it keep running if I close the page?', a: 'The countdown is calculated from the date each time the page opens, so it is always correct. Save it to find it again under Saved.' },
  ]}
>
  <section class="card" data-countdown aria-label="Countdown timer">
    <form class="tool-inputs" style="margin-top:0" onsubmit="return false">
      <div class="field" style="flex:1 1 220px"><label for="c-name">Event name</label><input id="c-name" class="input" type="text" maxlength="80" value="My event" data-in="name" /></div>
      <div class="field"><label for="c-date">Date</label><input id="c-date" class="input" type="date" value={formatISO(addDays(BUILD_TODAY, 30))} data-in="date" /></div>
      <div class="field"><label for="c-time">Time</label><input id="c-time" class="input" type="time" value="09:00" data-in="time" /></div>
    </form>
    <div class="quick-answer">
      <div class="answer-label" data-out="label">Countdown to My event</div>
      <div class="answer" data-out="when" style="font-size:clamp(22px,3vw,30px)">—</div>
    </div>
    <div class="countdown" aria-label="Time remaining">
      <div><b data-cd="d">0</b><span>days</span></div>
      <div><b data-cd="h">00</b><span>hours</span></div>
      <div><b data-cd="m">00</b><span>minutes</span></div>
      <div><b data-cd="s">00</b><span>seconds</span></div>
    </div>
    <div class="countdown-caption" data-out="cap"></div>
    <div class="actions">
      <a class="btn btn--primary" href="https://calendar.google.com/" target="_blank" rel="noopener nofollow" data-out="gcal"><Icon name="calAdd" size={18} />Add to Google Calendar</a>
      <button class="btn" type="button" data-action="ics"><Icon name="download" size={18} />Download .ics</button>
      <button class="btn" type="button" data-action="copy"><Icon name="link" size={18} />Copy share link</button>
      <button class="btn btn--outline" type="button" data-action="save"><Icon name="bookmark" size={18} />Save</button>
    </div>
  </section>
  <div slot="content" class="section card">
    <h2 style="margin-bottom:12px">Holiday countdowns</h2>
    <div class="prose"><p>Looking for Christmas, Thanksgiving or Easter? See the <a href="/days-until/">holiday countdowns</a> for the US, UK and Canada.</p></div>
  </div>
</SimpleToolPage>
<script>
  import { formatLong, formatNumber, formatTime12, parseISO, formatISO, addDays } from '../../lib/dates';
  import { googleCalendarUrl } from '../../lib/calendar-links';
  import { splitMs, pad2, copyText, downloadIcs, saveItem, setQuery, localToday } from '../../scripts/common';
  const root = document.querySelector<HTMLElement>('[data-countdown]')!;
  const inName = root.querySelector<HTMLInputElement>('[data-in="name"]')!, inDate = root.querySelector<HTMLInputElement>('[data-in="date"]')!, inTime = root.querySelector<HTMLInputElement>('[data-in="time"]')!;
  const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
  const q = new URLSearchParams(location.search);
  if (q.get('name')) inName.value = q.get('name')!.slice(0, 80);
  const at = q.get('at') ? new Date(q.get('at')!) : null;
  if (at && !isNaN(at.getTime())) { inDate.value = formatISO({ y: at.getFullYear(), m: at.getMonth() + 1, d: at.getDate() }); inTime.value = `${pad2(at.getHours())}:${pad2(at.getMinutes())}`; }
  else inDate.value = formatISO(addDays(localToday(), 30));
  let target = new Date();
  function compute() {
    const d = parseISO(inDate.value); const [h, m] = (inTime.value || '00:00').split(':').map(Number);
    if (!d) return;
    target = new Date(d.y, d.m - 1, d.d, h || 0, m || 0);
    const name = inName.value.trim() || 'My event';
    out('label').textContent = `Countdown to ${name}`;
    out('when').textContent = `${formatTime12(target.getHours(), target.getMinutes())}, ${formatLong(d)}`;
    (out('gcal') as HTMLAnchorElement).href = googleCalendarUrl({ title: name, at: target });
    setQuery({ name, at: target.toISOString() });
    tick();
  }
  function tick() {
    const ms = target.getTime() - Date.now(); const t = splitMs(ms);
    const set = (k: string, v: string) => { root.querySelector(`[data-cd="${k}"]`)!.textContent = v; };
    set('d', formatNumber(t.d)); set('h', pad2(t.h)); set('m', pad2(t.m)); set('s', pad2(t.s));
    out('cap').textContent = ms >= 0 ? 'Live — in your time zone.' : 'This moment has passed — showing time since.';
  }
  [inName, inDate, inTime].forEach((i) => i.addEventListener('input', compute));
  root.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest<HTMLElement>('[data-action]'); if (!t) return;
    const name = inName.value.trim() || 'My event';
    if (t.dataset.action === 'copy') copyText(location.href);
    else if (t.dataset.action === 'ics') downloadIcs({ title: name, at: target, url: location.href, uid: `${target.getTime()}-cd@${location.hostname}` }, 'countdown.ics');
    else saveItem({ label: `Countdown: ${name}`, url: location.href, detail: out('when').textContent || '' });
  });
  compute(); setInterval(tick, 1000);
</script>
