---
/** Root: language picker and x-default. No IP/browser-language redirect (per plan). */
import '../styles/global.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/space-grotesk/latin-700.css';
import { SITE } from '../config/site';
import { LIVE_LOCALES } from '../config/locales';
import { abs } from '../lib/seo';
import { t } from '../i18n';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{SITE.name}</title>
  <meta name="description" content={LIVE_LOCALES.map((l) => t(l.code, 'meta.tagline')).join(' ')} />
  <link rel="canonical" href={abs('/')} />
  {LIVE_LOCALES.map((l) => <link rel="alternate" hreflang={l.hreflang} href={abs(`/${l.code}/`)} />)}
  <link rel="alternate" hreflang="x-default" href={abs('/')} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta name="theme-color" content="#4338CA" />
</head>
<body>
  <main class="container picker">
    <div class="logo" style="justify-content:center"><span class="logo__mark"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg></span>{SITE.name}</div>
    <h1>{t('de', 'picker.title')}</h1>
    <p class="muted">{t('de', 'picker.lede')}</p>
    <ul class="picker-list">
      {LIVE_LOCALES.map((l) => <li><a class="btn btn--primary" href={`/${l.code}/`} hreflang={l.hreflang} lang={l.htmlLang}>{l.name}</a></li>)}
    </ul>
  </main>
</body>
</html>
