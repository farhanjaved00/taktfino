---
import CategoryPage from '../../components/CategoryPage.astro';
import { SITE } from '../../config/site';
import { HUBS, pickUntil } from '../../lib/links';
import { HOLIDAYS } from '../../lib/holidays';
import { releasedDaysUntil } from '../../lib/release';
const dates = releasedDaysUntil().filter((t) => t.kind === 'date').map((t) => ({ label: `Days until ${t.slug.replace(/-(\d+)$/, ' $1')}`, href: `/days-until/${t.slug}/` }));
---
<CategoryPage title={`Countdowns — Days Until Christmas, Holidays & Any Date | ${SITE.name}`} description="Live countdowns to Christmas, Thanksgiving, Easter, New Year and every major US, UK and Canadian holiday — or make your own."
  h1="Countdowns" intro="Live countdowns to holidays and events, updated every second in your time zone." path="/countdowns/"
  tools={[HUBS['days-until'], HUBS.countdown, HUBS['days-from-today'], HUBS['hours-from-now']]}
  groups={[{ title: 'Holiday countdowns', links: pickUntil(HOLIDAYS.map((h) => h.slug)) }, { title: 'Dates', links: dates }]} />
