---
import CategoryPage from '../../components/CategoryPage.astro';
import { SITE } from '../../config/site';
import { HUBS, pick } from '../../lib/links';
import { releasedNumbers } from '../../lib/release';
---
<CategoryPage title={`Time Calculators — Hours From Now & Countdown Timer | ${SITE.name}`} description="Find the exact time any number of hours from now or ago, and run a live countdown to any moment."
  h1="Time" intro="Hours from now, hours ago and live timers — in your own time zone." path="/time/"
  tools={[HUBS['hours-from-now'], HUBS.countdown, HUBS['date-duration-calculator'], HUBS['days-from-today']]}
  groups={[{ title: 'Hours from now', links: pick('hours-from-now', releasedNumbers('hours-from-now')) }]} />
