---
import SimpleToolPage from '../../components/SimpleToolPage.astro';
import { SITE } from '../../config/site';
import { BUILD_TODAY } from '../../lib/build';
import { addDays, businessDaysBetween, diffDays, formatISO, formatLong, formatNumber, ymdBetween } from '../../lib/dates';
import { CATEGORIES } from '../../lib/links';
const a = BUILD_TODAY, b = addDays(BUILD_TODAY, 90);
const ymd = ymdBetween(a, b);
const days = diffDays(a, b);
---
<SimpleToolPage
  title={`Date Duration Calculator — Days Between Two Dates | ${SITE.name}`}
  description="Count the days, weeks, months and business days between any two dates. Option to include the end date. Free and instant."
  h1="Days between two dates"
  intro="Pick a start and end date to see the exact duration in days, weeks, months and business days."
  path="/date-duration-calculator/" og="/og/date-duration-calculator.png" appName="Date duration calculator"
  crumbs={[{ name: 'Date tools', path: CATEGORIES['date-tools'].path }, { name: 'Date duration calculator', path: '/date-duration-calculator/' }]}
  related={['days-from-today', 'days-ago', 'age-calculator', 'days-until']}
  faq={[
    { q: 'Should I include the end date?', a: 'By default the calculator counts the days between the dates (end date excluded), which is how most deadlines and durations work. Tick “Include end date” to count both the first and last day, for example when counting the days of a trip or a hotel stay in nights + 1.' },
    { q: 'How are months counted?', a: 'Whole calendar months are counted first, then leftover days. For example, January 31 to March 1 is 1 month and 1 day.' },
    { q: 'Are public holidays excluded from business days?', a: 'Business days are Monday to Friday. Tick “Skip US federal holidays” to also skip observed US federal holidays.' },
  ]}
>
  <section class="card" data-duration aria-label="Duration calculator">
    <form class="tool-inputs" style="margin-top:0" onsubmit="return false">
      <div class="field"><label for="d-a">Start date</label><input id="d-a" class="input" type="date" value={formatISO(a)} data-in="a" /></div>
      <div class="field"><label for="d-b">End date</label><input id="d-b" class="input" type="date" value={formatISO(b)} data-in="b" /></div>
    </form>
    <div class="tool-inputs" style="margin-top:12px">
      <button type="button" class="toggle" aria-pressed="false" data-in="incl"><span class="dot" aria-hidden="true"></span>Include end date</button>
      <button type="button" class="toggle" aria-pressed="false" data-in="hol"><span class="dot" aria-hidden="true"></span>Skip US federal holidays</button>
    </div>
    <div class="quick-answer">
      <div class="answer-label" data-out="phrase">From {formatLong(a)} to {formatLong(b)}</div>
      <div class="answer" data-out="days" aria-live="polite">{formatNumber(days)} days</div>
      <div class="answer-sub" data-out="ymd">{ymd.years} years, {ymd.months} months, {ymd.days} days</div>
    </div>
    <div class="stats">
      <div><b data-out="weeks">{formatNumber(days / 7, 1)}</b><span>weeks</span></div>
      <div><b data-out="months">{formatNumber(days / 30.436875, 1)}</b><span>months</span></div>
      <div><b data-out="biz">{formatNumber(businessDaysBetween(a, b))}</b><span>business days</span></div>
      <div><b data-out="hours">{formatNumber(days * 24)}</b><span>hours</span></div>
    </div>
    <div class="actions"><button class="btn" type="button" data-action="copy">Copy share link</button><button class="btn btn--outline" type="button" data-action="save">Save</button></div>
  </section>
  <div slot="content" class="section card">
    <h2 style="margin-bottom:12px">How the duration is calculated</h2>
    <div class="prose">
      <p>The total is the number of days from the start date to the end date. Weeks are that total divided by 7; months use the average Gregorian month of 30.44 days. The “years, months, days” line counts whole calendar months first, so it matches how ages and contract terms are written.</p>
      <p>Business days count Monday to Friday after the start date up to and including the end date. With holidays switched on, observed US federal holidays are skipped too.</p>
    </div>
  </div>
</SimpleToolPage>
<script>
  import { addDays, businessDaysBetween, diffDays, formatISO, formatLong, formatNumber, parseISO, ymdBetween } from '../../lib/dates';
  import { usFederalHolidaySet } from '../../lib/holidays';
  import { copyText, saveItem, setQuery, localToday } from '../../scripts/common';
  const root = document.querySelector<HTMLElement>('[data-duration]')!;
  const inA = root.querySelector<HTMLInputElement>('[data-in="a"]')!, inB = root.querySelector<HTMLInputElement>('[data-in="b"]')!;
  const incl = root.querySelector<HTMLButtonElement>('[data-in="incl"]')!, hol = root.querySelector<HTMLButtonElement>('[data-in="hol"]')!;
  const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
  const q = new URLSearchParams(location.search);
  inA.value = q.get('from') && parseISO(q.get('from')) ? q.get('from')! : formatISO(localToday());
  inB.value = q.get('to') && parseISO(q.get('to')) ? q.get('to')! : formatISO(addDays(localToday(), 90));
  if (q.get('incl') === '1') incl.setAttribute('aria-pressed', 'true');
  if (q.get('hol') === '1') hol.setAttribute('aria-pressed', 'true');
  const on = (b: HTMLElement) => b.getAttribute('aria-pressed') === 'true';
  function render() {
    const a = parseISO(inA.value), b = parseISO(inB.value);
    if (!a || !b) return;
    let days = diffDays(a, b);
    const sign = days < 0 ? -1 : 1;
    if (on(incl)) days += sign;
    const ymd = ymdBetween(a, on(incl) ? addDays(b, sign) : b);
    const hs = on(hol) ? usFederalHolidaySet(Array.from({ length: Math.abs(b.y - a.y) + 1 }, (_, i) => Math.min(a.y, b.y) + i)) : undefined;
    const biz = Math.abs(businessDaysBetween(on(incl) ? addDays(a, -sign) : a, b, hs));
    out('phrase').textContent = `From ${formatLong(a)} to ${formatLong(b)}${on(incl) ? ' (end date included)' : ''}`;
    out('days').textContent = `${formatNumber(Math.abs(days))} day${Math.abs(days) === 1 ? '' : 's'}${days < 0 ? ' (end is before start)' : ''}`;
    out('ymd').textContent = `${Math.abs(ymd.years)} years, ${Math.abs(ymd.months)} months, ${Math.abs(ymd.days)} days`;
    out('weeks').textContent = formatNumber(Math.abs(days) / 7, 1);
    out('months').textContent = formatNumber(Math.abs(days) / 30.436875, 1);
    out('biz').textContent = formatNumber(biz);
    out('hours').textContent = formatNumber(Math.abs(days) * 24);
    setQuery({ from: inA.value, to: inB.value, incl: on(incl) ? '1' : null, hol: on(hol) ? '1' : null });
  }
  [inA, inB].forEach((i) => i.addEventListener('input', render));
  [incl, hol].forEach((b) => b.addEventListener('click', () => { b.setAttribute('aria-pressed', String(!on(b))); render(); }));
  root.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest<HTMLElement>('[data-action]'); if (!t) return;
    if (t.dataset.action === 'copy') copyText(location.href);
    else saveItem({ label: `${inA.value} → ${inB.value}: ${out('days').textContent}`, url: location.href });
  });
  render();
</script>
