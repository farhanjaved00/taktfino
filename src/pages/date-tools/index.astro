---
import CategoryPage from '../../components/CategoryPage.astro';
import { SITE } from '../../config/site';
import { HUBS, pick } from '../../lib/links';
import { releasedNumbers } from '../../lib/release';
---
<CategoryPage title={`Date Calculators — Days From Today, Weeks, Days Ago | ${SITE.name}`} description="Every date calculator in one place: add or subtract days and weeks, count business days, and measure the days between two dates."
  h1="Date tools" intro="Add or subtract days and weeks, skip weekends, or measure the gap between two dates." path="/date-tools/"
  tools={[HUBS['days-from-today'], HUBS['weeks-from-today'], HUBS['days-ago'], HUBS['date-duration-calculator']]}
  groups={[
    { title: 'Days from today', links: pick('days-from-today', releasedNumbers('days-from-today')) },
    { title: 'Weeks from today', links: pick('weeks-from-today', releasedNumbers('weeks-from-today')) },
    { title: 'Days ago', links: pick('days-ago', releasedNumbers('days-ago')) },
  ]} />
