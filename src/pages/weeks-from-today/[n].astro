---
import SpanPage from '../../components/SpanPage.astro';
import { releasedNumbers } from '../../lib/release';
export function getStaticPaths() {
  return releasedNumbers('weeks-from-today').map((n) => ({ params: { n: String(n) }, props: { n } }));
}
const { n } = Astro.props as { n: number };
---
<SpanPage family="weeks-from-today" n={n} />
