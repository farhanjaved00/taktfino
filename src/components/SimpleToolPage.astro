---
/** Shared shell for the stand-alone calculators (duration, age, countdown). */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Faq from './Faq.astro';
import AdSlot from './AdSlot.astro';
import { HUBS } from '../lib/links';
import { webAppSchema, type Crumb, type QA } from '../lib/seo';
interface Props { title: string; description: string; h1: string; intro: string; path: string; og: string; crumbs: Crumb[]; faq: QA[]; related: (keyof typeof HUBS)[]; appName: string }
const p = Astro.props;
---
<BaseLayout title={p.title} description={p.description} ogImage={p.og} schema={[webAppSchema(p.appName, p.path, p.description)]}>
  <Breadcrumbs crumbs={p.crumbs} />
  <div class="container">
    <div class="page-head"><h1>{p.h1}</h1><p>{p.intro}</p></div>
    <div class="tool-layout">
      <div><slot /></div>
      <aside class="tool-aside" aria-label="Related">
        <slot name="aside" />
        <div class="ad-desktop-only" style="justify-content:center"><AdSlot format="rectangle" /></div>
      </aside>
    </div>
    <div class="ad-wrap"><AdSlot format="leaderboard" /></div>
    <div class="ad-wrap ad-mobile-only"><AdSlot format="mobile" /></div>
    <slot name="content" />
    <Faq items={p.faq} />
    <section class="section" aria-labelledby="rel-h">
      <h2 id="rel-h" style="margin-bottom:14px">Related tools</h2>
      <div class="related-grid">{p.related.map((k) => <a href={HUBS[k].path}><b>{HUBS[k].name}</b><span>{HUBS[k].blurb}</span></a>)}</div>
    </section>
  </div>
</BaseLayout>
