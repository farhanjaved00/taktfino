---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Faq from './Faq.astro';
import AdSlot from './AdSlot.astro';
import Icon from './Icon.astro';
import Calendar from './Calendar.astro';
import { SITE } from '../config/site';
import { BUILD_NOW, BUILD_TODAY } from '../lib/build';
import { formatLong, formatNumber, formatTime12, formatUS, formatUK, zonedParts, MONTHS, WEEKDAYS, weekday } from '../lib/dates';
import { explainHours } from '../lib/facts';
import { releasedNumbers } from '../lib/release';
import { HUBS, CATEGORIES } from '../lib/links';
import { webAppSchema } from '../lib/seo';
import { googleCalendarUrl } from '../lib/calendar-links';

interface Props { n: number; hub?: boolean }
const { n, hub = false } = Astro.props;
const H = HUBS['hours-from-now'];
const released = releasedNumbers('hours-from-now');
const hrs = (k: number) => `${k} hour${k === 1 ? '' : 's'}`;
// Static fallback: build time shown in US Eastern; the browser replaces it with the visitor's local time.
const TZ = 'America/New_York';
const p = zonedParts(TZ, new Date(BUILD_NOW.getTime() + n * 3_600_000));
const resDate = { y: p.y, m: p.m, d: p.d };
const s0 = zonedParts(TZ, BUILD_NOW);
const staticAnswer = `${formatTime12(p.h, p.min)} on ${formatLong(resDate)}`;
const days = Math.floor(n / 24), rest = n % 24;

const title = hub ? `Hours From Now Calculator — What Time Will It Be? | ${SITE.name}` : `${n} Hours From Now — What Time Will It Be? | ${SITE.name}`;
const description = hub
  ? 'Find the exact time and date any number of hours from now, in your time zone. Live countdown, calendar and Google Calendar link.'
  : `${n} hours from now is ${n >= 24 ? `${days} day${days === 1 ? '' : 's'}${rest ? ` and ${rest} hour${rest === 1 ? '' : 's'}` : ''} ahead` : `${formatNumber(n * 60)} minutes ahead`}. See the exact time in your time zone, a live countdown and calendar.`;
const crumbs = hub
  ? [{ name: 'Time', path: CATEGORIES.time.path }, { name: H.name, path: H.path }]
  : [{ name: 'Time', path: CATEGORIES.time.path }, { name: H.name, path: H.path }, { name: `${hrs(n)} from now`, path: `/hours-from-now/${n}/` }];
const nearby = [n - 1, n + 1, n + 12, 24, 48, 72].filter((v, i, a) => v > 0 && v !== n && a.indexOf(v) === i);
const faq = [
  { q: hub ? 'How do I add hours to the current time?' : `What time will it be ${n} hours from now?`, a: hub ? 'Enter a number of hours. The calculator adds them to the current time on your device, so it is always in your time zone.' : `Add ${n} hours to the current time${n >= 24 ? ` — that is ${days} day${days === 1 ? '' : 's'}${rest ? ` plus ${rest} hour${rest === 1 ? '' : 's'}` : ''}` : ''}. The calculator above does it live in your time zone.` },
  { q: 'Does daylight saving time change the answer?', a: 'The calculator adds real elapsed hours. If clocks change in between, the clock time shown will reflect the change, which is what you would see on your phone.' },
  { q: `How many minutes is ${hub ? 'an hour' : hrs(n)}?`, a: hub ? '60 minutes, or 3,600 seconds.' : `${formatNumber(n * 60)} minutes, or ${formatNumber(n * 3600)} seconds.` },
];
const related = [HUBS['days-from-today'], HUBS.countdown, HUBS['date-duration-calculator'], HUBS['days-ago']];
const gcal = googleCalendarUrl({ title: `${hrs(n)} from now`, at: new Date(BUILD_NOW.getTime() + n * 3_600_000) });
---
<BaseLayout title={title} description={description} ogImage="/og/hours-from-now.png" schema={hub ? [webAppSchema('Hours from now calculator', H.path, description)] : []} bodyClass="has-sticky-cta">
  <Breadcrumbs crumbs={crumbs} />
  <div class="container" data-hours-tool data-n={n} data-hub={hub ? '1' : '0'} data-released={JSON.stringify(released)}>
    <div class="page-head">
      <h1 data-bind="h1">What time will it be {hrs(n)} from now?</h1>
      <p>Uses your device’s clock and time zone · <span data-bind="tz">times shown in ET until the page loads</span></p>
    </div>
    <div class="tool-layout">
      <section class="card" aria-labelledby="answer-label">
        <div class="answer-label" id="answer-label" data-bind="phrase">{hrs(n)} from now ({formatTime12(s0.h, s0.min)} ET) is</div>
        <div class="answer" data-bind="answer" aria-live="polite">{staticAnswer}</div>
        <div class="answer-sub"><b data-bind="us">{formatUS(resDate)}</b> (US) · <b data-bind="uk">{formatUK(resDate)}</b> (UK) · <span data-bind="time24">{String(p.h).padStart(2, '0')}:{String(p.min).padStart(2, '0')}</span> (24-hour)</div>

        <form class="tool-inputs no-print" onsubmit="return false">
          <div class="field"><label for="h-n">Hours</label><input id="h-n" class="input input--num" type="number" inputmode="numeric" min="1" max="100000" value={n} data-input="n" /></div>
          <div class="field"><label for="h-start">Start (date and time)</label><input id="h-start" class="input" type="datetime-local" data-input="start" /></div>
          <div class="seg" role="group" aria-label="Direction">
            <button type="button" aria-pressed="true" data-dir="1">From now</button>
            <button type="button" aria-pressed="false" data-dir="-1">Ago</button>
          </div>
        </form>

        <div class="countdown" aria-label="Countdown">
          <div><b data-cd="d">{days}</b><span>days</span></div>
          <div><b data-cd="h">{String(rest).padStart(2, '0')}</b><span>hours</span></div>
          <div><b data-cd="m">00</b><span>minutes</span></div>
          <div><b data-cd="s">00</b><span>seconds</span></div>
        </div>
        <div class="countdown-caption" data-bind="cdCaption">Live countdown in your time zone.</div>

        <div class="stats">
          <div><b data-bind="stDays">{formatNumber(n / 24, 2)}</b><span>days</span></div>
          <div><b data-bind="stWeeks">{formatNumber(n / 168, 2)}</b><span>weeks</span></div>
          <div><b data-bind="stMin">{formatNumber(n * 60)}</b><span>minutes</span></div>
          <div><b data-bind="stSec">{formatNumber(n * 3600)}</b><span>seconds</span></div>
        </div>

        <div class="actions no-print">
          <a class="btn btn--primary" href={gcal} target="_blank" rel="noopener nofollow" data-bind-href="gcal"><Icon name="calAdd" size={18} />Add to Google Calendar</a>
          <button class="btn" type="button" data-action="ics"><Icon name="download" size={18} />Download .ics</button>
          <button class="btn" type="button" data-action="copy"><Icon name="link" size={18} />Copy share link</button>
          <button class="btn" type="button" data-action="print"><Icon name="print" size={18} />Print</button>
          <button class="btn btn--outline" type="button" data-action="save"><Icon name="bookmark" size={18} />Save</button>
        </div>
      </section>
      <aside class="tool-aside" aria-label="Calendar and related">
        <Calendar result={resDate} today={BUILD_TODAY} />
        <div class="ad-desktop-only" style="justify-content:center"><AdSlot format="rectangle" /></div>
        <div class="card card--sm no-print">
          <h2 style="font-family:var(--font-body);font-size:17px;margin-bottom:10px">Nearby calculations</h2>
          <div class="chip-row">
            {nearby.map((v) => released.includes(v) ? <a class="chip chip--soft" href={`/hours-from-now/${v}/`}>{hrs(v)}</a> : <button type="button" class="chip chip--soft" data-set-n={v}>{hrs(v)}</button>)}
          </div>
        </div>
      </aside>
    </div>

    <div class="ad-wrap ad-mobile-only"><AdSlot format="mobile" /></div>

    <section class="section card" aria-labelledby="units-h">
      <h2 id="units-h" style="margin-bottom:14px"><span data-bind="unitsTitle">{hrs(n)}</span> in other forms</h2>
      <div class="table-wrap"><table class="data-table">
        <thead><tr><th scope="col">Starting point</th><th scope="col">Result</th></tr></thead>
        <tbody data-bind="rows">
          <tr><td>{hrs(n)} from now</td><td>{staticAnswer} (ET)</td></tr>
          <tr><td>{hrs(n)} after 9:00 AM today</td><td>—</td></tr>
          <tr><td>{hrs(n)} after midnight tonight</td><td>—</td></tr>
          <tr><td>{hrs(n)} ago</td><td>—</td></tr>
        </tbody>
      </table></div>
    </section>

    {!hub && (
      <section class="section card" aria-labelledby="ex-h">
        <h2 id="ex-h" style="margin-bottom:12px">About {hrs(n)}</h2>
        <div class="prose"><p>{explainHours(n)}</p></div>
      </section>
    )}
    {hub && (
      <section class="section" aria-labelledby="all-h">
        <h2 id="all-h" style="margin-bottom:14px">Popular hour calculations</h2>
        <div class="link-grid">{released.map((k) => <a href={`/hours-from-now/${k}/`}>{hrs(k)} from now</a>)}</div>
      </section>
    )}

    <div class="ad-wrap"><AdSlot format="leaderboard" /></div>
    <Faq items={faq} />
    <section class="section" aria-labelledby="rel-h">
      <h2 id="rel-h" style="margin-bottom:14px">Related tools</h2>
      <div class="related-grid">{related.map((r) => <a href={r.path}><b>{r.name}</b><span>{r.blurb}</span></a>)}</div>
      {!hub && <p class="small" style="margin-top:14px"><a href={H.path}>All hours-from-now calculations →</a></p>}
    </section>
  </div>
  <div class="sticky-cta" slot="after">
    <a class="btn btn--primary" href={gcal} data-sticky-gcal target="_blank" rel="noopener nofollow"><Icon name="calAdd" size={18} />Add to calendar</a>
    <button class="btn" type="button" data-sticky-action="save" style="flex:0 0 auto"><Icon name="bookmark" size={18} />Save</button>
  </div>
</BaseLayout>

<script>
  import { formatLong, formatUS, formatUK, formatTime12, formatNumber, monthGrid, MONTHS, formatMedium } from '../lib/dates';
  import { googleCalendarUrl } from '../lib/calendar-links';
  import { localToday, splitMs, pad2, copyText, downloadIcs, saveItem, addRecent, setQuery, renderCalendarCells, localTz } from '../scripts/common';

  const root = document.querySelector<HTMLElement>('[data-hours-tool]');
  if (root) {
    const pageN = Number(root.dataset.n);
    const isHub = root.dataset.hub === '1';
    const released: number[] = JSON.parse(root.dataset.released || '[]');
    const $ = (k: string) => root.querySelector<HTMLElement>(`[data-bind="${k}"]`)!;
    const nIn = root.querySelector<HTMLInputElement>('[data-input="n"]')!;
    const startIn = root.querySelector<HTMLInputElement>('[data-input="start"]')!;
    const q = new URLSearchParams(location.search);
    const parsedStart = q.get('start') ? new Date(q.get('start')!) : null;
    const state = {
      n: Math.max(1, Math.min(100000, Number(q.get('n')) || pageN)),
      dir: q.get('dir') === '-1' ? -1 : 1,
      fixedStart: parsedStart && !isNaN(parsedStart.getTime()) ? parsedStart : null as Date | null,
    };
    const hrs = (k: number) => `${k} hour${k === 1 ? '' : 's'}`;
    const cal = (d: Date) => ({ y: d.getFullYear(), m: d.getMonth() + 1, d: d.getDate() });
    const fmt = (d: Date) => `${formatTime12(d.getHours(), d.getMinutes())} on ${formatLong(cal(d))}`;
    const toLocalInput = (d: Date) => `${d.getFullYear()}-${pad2(d.getMonth() + 1)}-${pad2(d.getDate())}T${pad2(d.getHours())}:${pad2(d.getMinutes())}`;
    let result = new Date();

    function start() { return state.fixedStart ?? new Date(); }
    function render(full = true) {
      const s = start();
      result = new Date(s.getTime() + state.dir * state.n * 3_600_000);
      const ago = state.dir < 0;
      if (full) {
        $('h1').textContent = ago ? `What time was it ${hrs(state.n)} ago?` : `What time will it be ${hrs(state.n)} from now?`;
        $('tz').textContent = `Time zone: ${localTz()}`;
        $('unitsTitle').textContent = hrs(state.n);
        $('stDays').textContent = formatNumber(state.n / 24, 2);
        $('stWeeks').textContent = formatNumber(state.n / 168, 2);
        $('stMin').textContent = formatNumber(state.n * 60);
        $('stSec').textContent = formatNumber(state.n * 3600);
        if (document.activeElement !== nIn) nIn.value = String(state.n);
        root!.querySelectorAll<HTMLButtonElement>('[data-dir]').forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.dir) === state.dir)));
      }
      const fixed = !!state.fixedStart;
      $('phrase').textContent = `${hrs(state.n)} ${ago ? 'before' : 'after'} ${fixed ? fmt(s) : `now (${formatTime12(s.getHours(), s.getMinutes())})`} ${ago ? 'was' : 'is'}`;
      $('answer').textContent = fmt(result);
      $('us').textContent = formatUS(cal(result));
      $('uk').textContent = formatUK(cal(result));
      $('time24').textContent = `${pad2(result.getHours())}:${pad2(result.getMinutes())}`;
      if (document.activeElement !== startIn) startIn.value = toLocalInput(s);
      const c = cal(result);
      $('monthTitle').textContent = `${MONTHS[c.m - 1]} ${c.y}`;
      $('calendar').innerHTML = renderCalendarCells(monthGrid(c.y, c.m, localToday(), c));
      const today9 = new Date(); today9.setHours(9, 0, 0, 0);
      const midnight = new Date(); midnight.setHours(24, 0, 0, 0);
      const add = (d: Date, k: number) => new Date(d.getTime() + k * 3_600_000);
      $('rows').innerHTML = [
        [`${hrs(state.n)} from now`, add(new Date(), state.n)],
        [`${hrs(state.n)} after 9:00 AM today`, add(today9, state.n)],
        [`${hrs(state.n)} after midnight tonight`, add(midnight, state.n)],
        [`${hrs(state.n)} ago`, add(new Date(), -state.n)],
      ].map(([l, d]) => `<tr><td>${l}</td><td>${fmt(d as Date)}</td></tr>`).join('');
      const g = googleCalendarUrl({ title: `${hrs(state.n)} ${ago ? 'ago' : 'from now'}`, at: result });
      root!.querySelector<HTMLAnchorElement>('[data-bind-href="gcal"]')!.href = g;
      document.querySelectorAll<HTMLAnchorElement>('[data-sticky-gcal]').forEach((a) => (a.href = g));
      tick();
    }
    function tick() {
      const ms = result.getTime() - Date.now();
      const t = splitMs(ms);
      const set = (k: string, v: string) => { root!.querySelector(`[data-cd="${k}"]`)!.textContent = v; };
      set('d', formatNumber(t.d)); set('h', pad2(t.h)); set('m', pad2(t.m)); set('s', pad2(t.s));
      $('cdCaption').textContent = ms >= 0 ? `Counting down to ${formatMedium(cal(result))}.` : 'That time has passed — showing time elapsed since then.';
    }
    function shareUrl() {
      const u = new URL(location.origin + location.pathname);
      if (isHub || state.n !== pageN) u.searchParams.set('n', String(state.n));
      if (state.dir < 0) u.searchParams.set('dir', '-1');
      u.searchParams.set('start', start().toISOString());
      return u.toString();
    }
    function sync() { setQuery({ n: isHub || state.n !== pageN ? String(state.n) : null, dir: state.dir < 0 ? '-1' : null, start: state.fixedStart ? state.fixedStart.toISOString() : null }); }
    nIn.addEventListener('input', () => { if (nIn.value === '') return; state.n = Math.max(1, Math.min(100000, Math.round(Number(nIn.value)) || 1)); render(); sync(); });
    startIn.addEventListener('change', () => { const d = new Date(startIn.value); if (!isNaN(d.getTime())) { state.fixedStart = d; render(); sync(); } });
    root.addEventListener('click', (e) => {
      const t = (e.target as HTMLElement).closest<HTMLElement>('[data-dir],[data-set-n],[data-action]');
      if (!t) return;
      if (t.dataset.dir) { state.dir = Number(t.dataset.dir); render(); sync(); }
      else if (t.dataset.setN) { state.n = Number(t.dataset.setN); render(); sync(); }
      else act(t.dataset.action!);
    });
    document.addEventListener('click', (e) => { const t = (e.target as HTMLElement).closest<HTMLElement>('[data-sticky-action]'); if (t) act(t.dataset.stickyAction!); });
    function act(a: string) {
      const label = `${hrs(state.n)} ${state.dir < 0 ? 'ago' : 'from now'}: ${fmt(result)}`;
      if (a === 'copy') copyText(shareUrl());
      else if (a === 'print') window.print();
      else if (a === 'ics') downloadIcs({ title: label, at: result, url: shareUrl(), uid: `${result.getTime()}-h@${location.hostname}` }, `${state.n}-hours.ics`);
      else if (a === 'save') saveItem({ label, url: shareUrl(), detail: fmt(result) });
    }
    void released;
    render();
    addRecent({ label: `${hrs(state.n)} from now`, url: location.pathname, detail: fmt(result) });
    setInterval(() => { if (state.fixedStart) tick(); else render(false); }, 1000);
  }
</script>
