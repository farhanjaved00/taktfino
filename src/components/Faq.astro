---
import { faqSchema } from '../lib/seo';
import type { LocaleCode } from '../config/locales';
import { t } from '../i18n';
import JsonLd from './JsonLd.astro';
interface Props { items: { q: string; a: string }[]; locale: LocaleCode }
const { items, locale } = Astro.props;
---
{items.length > 0 && (
  <section class="section" aria-labelledby="faq-h">
    <h2 id="faq-h" style="margin-bottom:14px">{t(locale, 'common.faq')}</h2>
    <div class="faq">{items.map((x, i) => <details open={i === 0}><summary>{x.q}</summary><div set:html={x.a} /></details>)}</div>
  </section>
)}
{items.length > 0 && <JsonLd data={faqSchema(items)} />}
