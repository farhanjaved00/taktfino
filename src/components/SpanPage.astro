---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import SpanTool from './SpanTool.astro';
import Faq from './Faq.astro';
import AdSlot from './AdSlot.astro';
import Icon from './Icon.astro';
import { SITE } from '../config/site';
import { BUILD_TODAY } from '../lib/build';
import { spanResult, type SpanFamily } from '../lib/span';
import { addBusinessDays, formatLong, formatMedium, formatNumber, spanStats, weeksAndDays } from '../lib/dates';
import { explainSpan } from '../lib/facts';
import { releasedNumbers } from '../lib/release';
import { HUBS, CATEGORIES } from '../lib/links';
import { webAppSchema } from '../lib/seo';
import { googleCalendarUrl } from '../lib/calendar-links';
import { BUILD_NOW } from '../lib/build';
import RelatedGuides from './RelatedGuides.astro';
import { nPath } from '../lib/links';

interface Props { family: SpanFamily; n: number; hub?: boolean }
const { family, n, hub = false } = Astro.props;
const today = BUILD_TODAY;
const result = spanResult(family, n, today, false);
const stats = spanStats(today, result);
const past = family === 'days-ago';
const weeks = family === 'weeks-from-today';
const u = (k: number) => (weeks ? (k === 1 ? 'week' : 'weeks') : (k === 1 ? 'day' : 'days'));
const Unit = weeks ? 'Weeks' : 'Days';
const H = HUBS[family];
const released = releasedNumbers(family);

const title = hub
  ? past ? `Days Ago Calculator — What Date Was It? | ${SITE.name}` : `${Unit} From Today Calculator — Add ${Unit} to Any Date | ${SITE.name}`
  : past ? `${n} ${u(n)[0].toUpperCase() + u(n).slice(1)} Ago — ${formatMedium(result)} | ${SITE.name}` : `${n} ${u(n)[0].toUpperCase() + u(n).slice(1)} From Today — ${formatMedium(result)} | ${SITE.name}`;
const description = hub
  ? past
    ? 'Find the date any number of days ago, with business days, a calendar and a live timer. Free, updated daily, US and UK date formats.'
    : `Add any number of ${weeks ? 'weeks' : 'days'} to today or any start date. See the exact date, weekday, business days and a calendar, then add it to Google Calendar.`
  : past
    ? `${n} ${u(n)} ago was ${formatLong(result)} (${formatMedium(result)}). See the calendar, business days, time elapsed and other units.`
    : `${n} ${u(n)} from today is ${formatLong(result)}. See the countdown, calendar, ${formatNumber(stats.businessDays)} business days, and add it to your calendar.`;

const crumbs = hub
  ? [{ name: 'Date tools', path: CATEGORIES['date-tools'].path }, { name: H.name, path: H.path }]
  : [{ name: 'Date tools', path: CATEGORIES['date-tools'].path }, { name: H.name, path: H.path }, { name: `${n} ${u(n)}${past ? ' ago' : ' from today'}`, path: `/${family}/${n}/` }];

const paragraphs = hub ? [] : explainSpan({ family, n, today, result });
const biz = !weeks ? addBusinessDays(today, past ? -n : n) : null;

const faq = hub
  ? [
      { q: past ? 'How do I work out a date in the past?' : `How do I add ${weeks ? 'weeks' : 'days'} to a date?`, a: past ? 'Enter the number of days and the calculator counts backwards from today (or the start date you choose), taking month lengths and leap years into account.' : `Enter a number and the calculator counts forward from today (or the start date you choose). It handles different month lengths and leap years for you.` },
      { q: 'Does the count include today?', a: `No. Today is day 0, so ${past ? 'yesterday is 1 day ago' : 'tomorrow is 1 day from today'}. This matches how deadlines and notice periods are normally counted.` },
      ...(!weeks ? [{ q: 'Can I skip weekends?', a: 'Yes. Switch on “Business days only” to count Monday to Friday. Public holidays are not skipped automatically, so check local holiday dates for strict legal deadlines.' }] : []),
      { q: 'Which time zone is used?', a: 'Your device’s local date. The page also updates itself at midnight if you leave it open.' },
    ]
  : [
      { q: `What is the date ${n} ${u(n)} ${past ? 'ago' : 'from today'}?`, a: `${n} ${u(n)} ${past ? 'before' : 'after'} ${formatLong(today)} is <b>${formatLong(result)}</b>.` },
      { q: `Does ${n} ${u(n)} ${past ? 'ago' : 'from today'} include today?`, a: `No. Today counts as day 0, so the result is the ${n}${weeks ? ` × 7 = ${n * 7}th` : 'th'} day ${past ? 'before' : 'after'} today. If your rule counts today as day 1, use ${weeks ? `${n * 7 - 1} days` : `${Math.max(1, n - 1)} ${u(Math.max(1, n - 1))}`} instead.` },
      biz
        ? { q: `What if I only count business days?`, a: `${n} business days ${past ? 'ago' : 'from today'} is <b>${formatLong(biz)}</b>, skipping Saturdays and Sundays. Public holidays are not skipped automatically.` }
        : { q: `How many days is ${n} ${u(n)}?`, a: `${n} ${u(n)} is ${formatNumber(n * 7)} days, or about ${stats.months.toFixed(1)} months.` },
      { q: `How many weeks and months is that?`, a: `${formatNumber(stats.days)} days is ${weeksAndDays(stats.days)} (${formatNumber(stats.weeks, 1)} weeks), or about ${formatNumber(stats.months, 1)} months.` },
      past
        ? { q: `Is ${n} ${u(n)} ago the same as ${n} ${u(n)} before today?`, a: `Yes. Both mean counting back ${n} ${u(n)} from today's date, which gives ${formatLong(result)}.` }
        : { q: `Is ${n} ${u(n)} from now the same as ${n} ${u(n)} from today?`, a: `For dates, yes — both land on ${formatLong(result)}. If you need an exact clock time ${weeks ? `${n * 7 * 24}` : `${n * 24}`} hours from this moment, use the <a href="/hours-from-now/">hours from now</a> calculator.` },
    ];

const related = [
  ...(family !== 'days-from-today' ? [{ a: HUBS['days-from-today'].name, b: HUBS['days-from-today'].blurb, href: HUBS['days-from-today'].path }] : []),
  ...(family !== 'weeks-from-today' ? [{ a: HUBS['weeks-from-today'].name, b: HUBS['weeks-from-today'].blurb, href: HUBS['weeks-from-today'].path }] : []),
  ...(family !== 'days-ago' ? [{ a: HUBS['days-ago'].name, b: HUBS['days-ago'].blurb, href: HUBS['days-ago'].path }] : []),
  { a: HUBS['date-duration-calculator'].name, b: HUBS['date-duration-calculator'].blurb, href: HUBS['date-duration-calculator'].path },
  { a: HUBS['days-until'].name, b: HUBS['days-until'].blurb, href: HUBS['days-until'].path },
].slice(0, 4);

const schema = hub ? [webAppSchema(`${H.name} calculator`, H.path, description)] : [];
// pages that land on the same date, or the mirror question (only if released)
const twins = hub ? [] : [
  family === 'days-from-today' && n % 7 === 0 ? { href: nPath('weeks-from-today', n / 7), label: `${n / 7} week${n / 7 === 1 ? '' : 's'} from today` } : null,
  family === 'weeks-from-today' ? { href: nPath('days-from-today', n * 7), label: `${n * 7} days from today` } : null,
  family === 'days-from-today' ? { href: nPath('days-ago', n), label: `${n} days ago` } : null,
  family === 'days-ago' ? { href: nPath('days-from-today', n), label: `${n} days from today` } : null,
].filter((x): x is { href: string; label: string } => !!x && !!x.href);
const POPULAR: Record<SpanFamily, number[]> = {
  'days-from-today': [90, 30, 60, 45, 14, 28, 180, 21, 10, 120, 7, 75],
  'weeks-from-today': [6, 2, 12, 8, 4, 10, 3, 16, 20, 26],
  'days-ago': [30, 90, 60, 45, 14, 7, 100, 180, 120, 10],
};
const popular = hub ? [] : POPULAR[family].filter((k) => k !== n).map((k) => ({ k, href: nPath(family, k) })).filter((x) => x.href).slice(0, 10);
const stickyGcal = googleCalendarUrl({ title: `${n} ${u(n)} ${past ? 'ago' : 'from today'}`, date: result });
const label = (k: number) => `${k} ${u(k)}${past ? ' ago' : ''}`;
---
<BaseLayout title={title} description={description} ogImage={`/og/${family}.png`} schema={schema} bodyClass="has-sticky-cta" modified={BUILD_NOW}>
  <Breadcrumbs crumbs={crumbs} />
  <div class="container">
    <SpanTool family={family} n={n} today={today} hub={hub} />

    {!hub && (
      <section class="section card" aria-labelledby="explain-h">
        <h2 id="explain-h" style="margin-bottom:12px">About {n} {u(n)} {past ? 'ago' : 'from today'}</h2>
        <div class="prose">
          {paragraphs.map((p) => <p>{p}</p>)}
          {twins.length > 0 && <p>See also: {twins.map((t, i) => <>{i > 0 && ' · '}<a href={t.href}>{t.label}</a></>)}.</p>}
        </div>
        <h2 style="margin:24px 0 10px">How to calculate it</h2>
        <div class="prose">
          <p>
            {past
              ? `Start from today and count back ${n} days. Months have 28 to 31 days, so it is easy to slip by a day when counting by hand. The calculator handles month lengths and leap years, and with “Business days only” on it skips Saturdays and Sundays.`
              : weeks
                ? `Multiply ${n} weeks by 7 to get ${n * 7} days, then count forward from today. Because a week is always 7 days, the answer always falls on the same weekday as today.`
                : `Start from today and count forward ${n} days, with today as day 0. Months have 28 to 31 days, so the calculator takes care of month lengths and leap years — and with “Business days only” on, it skips Saturdays and Sundays.`}
          </p>
        </div>
      </section>
    )}

    {hub && (
      <section class="section" aria-labelledby="all-h">
        <div class="section-head"><h2 id="all-h">Popular {H.name.toLowerCase()} dates</h2></div>
        <div class="link-grid">
          {released.map((k) => <a href={`/${family}/${k}/`}>{label(k)}</a>)}
        </div>
      </section>
    )}
    {hub && (
      <section class="section card" aria-labelledby="how-h">
        <h2 id="how-h" style="margin-bottom:12px">How this calculator works</h2>
        <div class="prose">
          <p>{past
            ? 'The calculator subtracts whole calendar days from today’s date in your time zone. It accounts for months of different lengths and for leap years, so the result is exact. Turn on business days to step back over weekdays only.'
            : `The calculator adds whole ${weeks ? 'weeks (7 days each)' : 'calendar days'} to today’s date in your time zone. It accounts for months of different lengths and for leap years.${weeks ? '' : ' Turn on business days to count Monday–Friday only.'}`}</p>
          <p>Every result shows the full date with weekday, the US (MM/DD/YYYY) and UK (DD/MM/YYYY) formats, the day of the year, a calendar, and buttons to add it to Google Calendar, download an .ics file, copy a share link or print.</p>
        </div>
      </section>
    )}

    <div class="ad-wrap"><AdSlot format="leaderboard" /></div>

    <Faq items={faq} />

    {popular.length > 0 && (
      <section class="section" aria-labelledby="pop-h">
        <h2 id="pop-h" style="margin-bottom:14px">Popular {past ? 'days-ago' : weeks ? 'weeks-from-today' : 'days-from-today'} dates</h2>
        <div class="link-grid">{popular.map((x) => <a href={x.href!}>{label(x.k)}{past ? '' : ' from today'}</a>)}</div>
      </section>
    )}

    <RelatedGuides paths={[`/${family}/${n}/`, H.path]} />

    <section class="section" aria-labelledby="rel-h">
      <h2 id="rel-h" style="margin-bottom:14px">Related tools</h2>
      <div class="related-grid">
        {related.map((r) => <a href={r.href}><b>{r.a}</b><span>{r.b}</span></a>)}
      </div>
      {!hub && <p class="small" style="margin-top:14px"><a href={H.path}>All {H.name.toLowerCase()} calculations →</a></p>}
    </section>
  </div>

  <div class="sticky-cta" slot="after">
    <a class="btn btn--primary" href={stickyGcal} data-sticky-gcal target="_blank" rel="noopener nofollow"><Icon name="calAdd" size={18} />Add to calendar</a>
    <button class="btn" type="button" data-sticky-action="save" style="flex:0 0 auto"><Icon name="bookmark" size={18} />Save</button>
  </div>
</BaseLayout>
