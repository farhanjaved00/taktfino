---
import { PEOPLE, type PersonId } from '../config/site';
import type { LocaleCode } from '../config/locales';
import { t } from '../i18n';
import { fmtDateMedium } from '../i18n/format';
import { personUrl } from '../lib/seo';
interface Props { locale: LocaleCode; author: PersonId; reviewer?: PersonId; updated: Date }
const { locale, author, reviewer, updated } = Astro.props;
const a = PEOPLE[author];
const r = reviewer ? PEOPLE[reviewer] : null;
const cal = { y: updated.getUTCFullYear(), m: updated.getUTCMonth() + 1, d: updated.getUTCDate() };
const initials = (n: string) => n.replace(/[^A-Za-zÄÖÜäöü ]/g, '').split(' ').filter(Boolean).map((w) => w[0]).slice(0, 2).join('') || '•';
---
<aside class="author-box" aria-label={t(locale, 'common.author')}>
  <span class="avatar" aria-hidden="true">{initials(a.name)}</span>
  <div>
    <div><span class="muted">{t(locale, 'common.author')}:</span> <a href={personUrl(author, locale)} rel="author">{a.name}</a>{r && <> · <span class="muted">{t(locale, 'common.reviewer')}:</span> <a href={personUrl(reviewer!, locale)}>{r.name}</a></>}</div>
    <div class="muted small">{t(locale, 'common.lastUpdated')}: <time datetime={updated.toISOString().slice(0, 10)}>{fmtDateMedium(locale, cal)}</time></div>
  </div>
</aside>
