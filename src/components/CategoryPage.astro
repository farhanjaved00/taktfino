---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import AdSlot from './AdSlot.astro';
import type { NavLink } from '../lib/links';
interface Props { title: string; description: string; h1: string; intro: string; path: string; tools: { name: string; path: string; blurb: string }[]; groups: { title: string; links: NavLink[] }[] }
const p = Astro.props;
---
<BaseLayout title={p.title} description={p.description}>
  <Breadcrumbs crumbs={[{ name: p.h1, path: p.path }]} />
  <div class="container">
    <div class="page-head"><h1>{p.h1}</h1><p>{p.intro}</p></div>
    <section aria-labelledby="t-h">
      <h2 id="t-h" class="sr-only">Tools</h2>
      <div class="related-grid">{p.tools.map((t) => <a href={t.path}><b>{t.name}</b><span>{t.blurb}</span></a>)}</div>
    </section>
    <div class="ad-wrap"><AdSlot format="leaderboard" /></div>
    {p.groups.filter((g) => g.links.length).map((g) => (
      <section class="section" aria-label={g.title}>
        <h2 style="margin-bottom:14px">{g.title}</h2>
        <div class="link-grid">{g.links.map((l) => <a href={l.href}>{l.label}</a>)}</div>
      </section>
    ))}
    <slot />
  </div>
</BaseLayout>
