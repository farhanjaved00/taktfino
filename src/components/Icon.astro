---
import { ICONS, type IconName } from '../lib/icons';
interface Props { name: IconName; size?: number; color?: string; stroke?: number; label?: string }
const { name, size = 20, color = 'currentColor', stroke = 2, label } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke={color} stroke-width={stroke} stroke-linecap="round" stroke-linejoin="round" aria-hidden={label ? undefined : 'true'} role={label ? 'img' : undefined} aria-label={label}><path d={ICONS[name]} /></svg>
