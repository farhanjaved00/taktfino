---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
interface Props { title: string; description: string; h1: string; path: string; updated?: string; schema?: unknown[] }
const p = Astro.props;
---
<BaseLayout title={p.title} description={p.description} path={p.path} schema={p.schema}>
  <Breadcrumbs crumbs={[{ name: p.h1, path: p.path }]} />
  <div class="container">
    <article class="article" style="max-width:860px;margin-top:8px">
      <h1>{p.h1}</h1>
      {p.updated && <p class="small muted" style="margin-top:8px">Last updated {p.updated}</p>}
      <div class="prose" style="margin-top:16px"><slot /></div>
    </article>
  </div>
</BaseLayout>
