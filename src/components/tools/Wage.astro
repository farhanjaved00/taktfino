---
/** Stundenlohnrechner — monthly ↔ hourly with the 4,33 factor, yearly, Mindestlohn check. */
import type { LocaleCode } from '../../config/locales';
import { t, dict } from '../../i18n';
import { minimumWage, upcomingMinimumWage, monthlyToHourly } from '../../tools/wage';
import { fmtMoney } from '../../i18n/format';
import Icon from '../Icon.astro';
interface Props { locale: LocaleCode; todayIso: string }
const { locale, todayIso } = Astro.props;
const u = (k: string) => t(locale, `ui.wage.${k}`);
const c = (k: string) => t(locale, `common.${k}`);
const M = { ui: (dict(locale) as { ui: { wage: Record<string, string> } }).ui.wage, common: (dict(locale) as { common: Record<string, string> }).common };
const mw = minimumWage('DE', todayIso);
const next = upcomingMinimumWage('DE', todayIso);
---
<section class="card tool" data-wage data-locale={locale} data-msgs={JSON.stringify(M)} aria-label={t(locale, 'tools.wage.name')}>
  <div class="seg" role="group" aria-label={u('mode')}>
    <button type="button" aria-pressed="true" data-mode="m2h">{u('m2h')}</button>
    <button type="button" aria-pressed="false" data-mode="h2m">{u('h2m')}</button>
  </div>
  <div class="tool-inputs">
    <div class="field" data-show="m2h"><label for="w-month">{u('monthly')}</label><input id="w-month" class="input input--num" type="text" inputmode="decimal" value="3.000" data-in="month" /></div>
    <div class="field" data-show="h2m" hidden><label for="w-hour">{u('hourly')}</label><input id="w-hour" class="input input--num" type="text" inputmode="decimal" value="17,31" data-in="hour" /></div>
    <div class="field"><label for="w-wh">{u('weeklyHours')}</label><input id="w-wh" class="input input--num" type="text" inputmode="decimal" value="40" data-in="wh" /></div>
    <div class="field"><label for="w-country">{c('country')}</label><select id="w-country" class="input" data-in="country"><option value="DE">{c('DE')}</option><option value="AT">{c('AT')}</option><option value="CH">{c('CH')}</option></select></div>
  </div>
  <div class="result-box" aria-live="polite">
    <div class="answer-label" data-out="label">{u('hourlyResult')}</div>
    <div class="answer" data-out="main">{fmtMoney(locale, monthlyToHourly(3000, 40))}</div>
    <div class="stats">
      <div><b data-out="hourly">–</b><span>{u('perHour')}</span></div>
      <div><b data-out="monthly">–</b><span>{u('perMonth')}</span></div>
      <div><b data-out="yearly">–</b><span>{u('perYear')}</span></div>
      <div><b data-out="mhours">–</b><span>{u('hoursPerMonth')}</span></div>
    </div>
    <p class="mw-check" data-out="mw"></p>
  </div>
  <div class="actions no-print">
    <button class="btn btn--primary" type="button" data-action="copy"><Icon name="check" size={18} />{c('copy')}</button>
    <button class="btn" type="button" data-action="share"><Icon name="link" size={18} />{c('share')}</button>
  </div>
</section>
<script>
  import { monthlyToHourly, hourlyToMonthly, monthlyHours, minimumWage, upcomingMinimumWage, minimumWageNote } from '../../tools/wage';
  import { copyText, setQuery, getQuery, saveHistory, track, trackCalculate, fmt } from '../../scripts/client';
  const root = document.querySelector<HTMLElement>('[data-wage]');
  if (root) {
    const M = JSON.parse(root.dataset.msgs!) as { ui: Record<string, string>; common: Record<string, string> };
    const $ = (k: string) => root.querySelector<HTMLInputElement & HTMLSelectElement>(`[data-in="${k}"]`)!;
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
    const num = (s: string) => { const v = Number(s.replace(/\s/g, '').replace(/\.(?=\d{3}(\D|$))/g, '').replace(',', '.')); return isFinite(v) ? v : NaN; };
    let mode: 'm2h' | 'h2m' = 'm2h';
    const q = getQuery();
    if (q.get('m')) $('month').value = q.get('m')!; if (q.get('h')) { $('hour').value = q.get('h')!; mode = 'h2m'; }
    if (q.get('wh')) $('wh').value = q.get('wh')!; if (q.get('c')) $('country').value = q.get('c')!;
    const today = new Date().toISOString().slice(0, 10);
    let hourly = 0, monthly = 0;
    function money(n: number) { const cur = $('country').value === 'CH' ? 'CHF' : 'EUR'; return n.toLocaleString('de-DE', { style: 'currency', currency: cur }); }
    function render() {
      root!.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mode === mode)));
      root!.querySelectorAll<HTMLElement>('[data-show]').forEach((el) => (el.hidden = el.dataset.show !== mode));
      const wh = num($('wh').value);
      if (mode === 'm2h') { monthly = num($('month').value); hourly = monthlyToHourly(monthly, wh); }
      else { hourly = num($('hour').value); monthly = hourlyToMonthly(hourly, wh); }
      if (!isFinite(hourly) || !isFinite(monthly) || !(wh > 0)) { out('main').textContent = '–'; return; }
      out('label').textContent = mode === 'm2h' ? M.ui.hourlyResult : M.ui.monthlyResult;
      out('main').textContent = money(mode === 'm2h' ? hourly : monthly);
      out('hourly').textContent = money(hourly);
      out('monthly').textContent = money(monthly);
      out('yearly').textContent = money(monthly * 12);
      out('mhours').textContent = fmt('de-DE', monthlyHours(wh), 2);
      const c = $('country').value as 'DE' | 'AT' | 'CH';
      const mw = minimumWage(c, today);
      const el = out('mw');
      if (!mw) { el.className = 'mw-check'; el.textContent = minimumWageNote(c); }
      else {
        const ok = hourly + 1e-9 >= mw.hourly;
        el.className = `mw-check ${ok ? 'ok' : 'bad'}`;
        const nx = upcomingMinimumWage(c, today);
        el.textContent = (ok ? M.ui.mwOk : M.ui.mwBad).replace('{mw}', money(mw.hourly)).replace('{from}', mw.from.split('-').reverse().join('.'))
          + (nx ? ' ' + M.ui.mwNext.replace('{mw}', money(nx.hourly)).replace('{from}', nx.from.split('-').reverse().join('.')) : '');
      }
      trackCalculate('wage');
    }
    root.addEventListener('input', render);
    root.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button'); if (!b) return;
      if (b.dataset.mode) { mode = b.dataset.mode as 'm2h' | 'h2m'; if (mode === 'h2m') $('hour').value = fmt('de-DE', hourly, 2, 2); else $('month').value = fmt('de-DE', monthly, 2); render(); return; }
      const text = `${money(monthly)} / ${M.ui.perMonth} = ${money(hourly)} / ${M.ui.perHour} (${$('wh').value} h/${M.ui.week})`;
      if (b.dataset.action === 'copy') { copyText(text, M.common.copied); track('copy_result', { tool: 'wage' }); }
      if (b.dataset.action === 'share') { const url = setQuery({ m: mode === 'm2h' ? $('month').value : null, h: mode === 'h2m' ? $('hour').value : null, wh: $('wh').value, c: $('country').value }); copyText(url, M.common.linkCopied); saveHistory({ tool: 'wage', label: text, url }); track('share', { tool: 'wage' }); }
    });
    render();
  }
</script>
