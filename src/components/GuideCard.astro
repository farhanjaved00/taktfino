---
import Icon from './Icon.astro';
import { GUIDE_ART, readingMinutes, type Guide } from '../lib/guides';
interface Props { guide: Guide }
const { guide } = Astro.props;
const art = GUIDE_ART[guide.data.category] || GUIDE_ART.Calendar;
---
<a class="guide-card" href={`/guides/${guide.id}/`}>
  <div class="guide-card__art" style={`background:${art.bg}`}><Icon name={art.icon} size={56} stroke={1.5} color="#12142A" /></div>
  <div class="guide-card__body">
    <div class="tag">{guide.data.category}</div>
    <h3>{guide.data.title}</h3>
    <div class="small muted">{readingMinutes(guide.body)} min read</div>
  </div>
</a>
