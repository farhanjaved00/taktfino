---
import { type CalDate, MONTHS, monthGrid } from '../lib/dates';
interface Props { result: CalDate; today: CalDate }
const { result, today } = Astro.props;
const cells = monthGrid(result.y, result.m, today, result);
---
<div class="card card--sm">
  <div class="cal-title" data-bind="monthTitle">{MONTHS[result.m - 1]} {result.y}</div>
  <div class="cal" data-bind="calendar" role="img" aria-label={`Calendar for ${MONTHS[result.m - 1]} ${result.y} with the result date highlighted`}>
    {['S', 'M', 'T', 'W', 'T', 'F', 'S'].map((d) => <div class="dow" aria-hidden="true">{d}</div>)}
    {cells.map((c) => c.date
      ? <div class:list={['c', { we: c.isWeekend, res: c.isResult, tod: c.isToday }]}>{c.date.d}</div>
      : <div class="c" aria-hidden="true"></div>)}
  </div>
  <div class="cal-legend">
    <span><i style="background:#4338CA"></i>Result</span>
    <span><i style="border:2px solid #D97706"></i>Today</span>
  </div>
</div>
