---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import ArticleList from '../ArticleList.astro';
import Icon from '../Icon.astro';
import { SITE } from '../../config/site';
import type { LocaleCode } from '../../config/locales';
import { toolsFor, toolPath, categoryPath, type CategoryId } from '../../config/tool-map';
import { alternatesFor, articleEntries, entryLocale } from '../../lib/registry';
import { t } from '../../i18n';
interface Props { locale: LocaleCode; category: CategoryId }
const { locale, category } = Astro.props;
const path = categoryPath(category, locale);
const name = t(locale, `categories.${category}.name`);
const articles = (await articleEntries()).filter((a) => entryLocale(a.id) === locale && a.data.category === category);
---
<BaseLayout locale={locale} title={`${name} – Rechner & Ratgeber | ${SITE.name}`} description={t(locale, `categories.${category}.meta`)} path={path} alternates={await alternatesFor(`category:${category}`)}>
  <Breadcrumbs locale={locale} crumbs={[{ name, path }]} />
  <div class="container">
    <div class="page-head"><h1>{name}</h1><p>{t(locale, `categories.${category}.blurb`)}</p></div>
    <div class="cat-grid">
      {toolsFor(locale).filter((x) => x.category === category).map((x) => (
        <a class="cat-card tool-card" href={toolPath(x.id, locale)}>
          <span class="cat-card__icon"><Icon name={x.icon} size={22} color="#4338CA" /></span>
          <div><h2 class="tool-card__h">{t(locale, `tools.${x.id}.name`)}</h2><p class="small muted" style="margin:4px 0 0">{t(locale, `tools.${x.id}.short`)}</p></div>
        </a>
      ))}
    </div>
    <ArticleList locale={locale} entries={articles} title={t(locale, 'nav.guides')} />
    <section class="section card prose-card"><div class="prose">{t(locale, `categories.${category}.intro`).split('\n\n').map((para) => <p>{para}</p>)}</div></section>
  </div>
</BaseLayout>
