{
  "$comment": "Automatic release schedule. The weekly 'Release next batch' workflow adds the next unreleased batch to release.json once at least `intervalDays` have passed since the last release. Set paused=true to stop. Edit or add batches freely; never remove a batch that has releasedOn set.",
  "paused": false,
  "intervalDays": 14,
  "lastRelease": null,
  "batches": [
    { "name": "Batch 2 — days 31–90, weeks 13–26, all holidays", "releasedOn": null,
      "add": { "days-from-today": ["31-90"], "weeks-from-today": ["13-26"], "days-until": ["all-holidays"] } },
    { "name": "Batch 3 — days 91–180, days ago 1–60", "releasedOn": null,
      "add": { "days-from-today": ["91-180"], "days-ago": ["1-60"] } },
    { "name": "Batch 4 — days 181–365, 400, 500, 1000", "releasedOn": null,
      "add": { "days-from-today": ["181-365", 400, 500, 1000] } },
    { "name": "Batch 5 — hours 1–72, weeks 27–52, days ago 61–180", "releasedOn": null,
      "add": { "hours-from-now": ["1-72"], "weeks-from-today": ["27-52"], "days-ago": ["61-180"] } },
    { "name": "Batch 6 — weeks 53–104, hours 73–168, days ago 181–365", "releasedOn": null,
      "add": { "weeks-from-today": ["53-104"], "hours-from-now": ["73-168"], "days-ago": ["181-365"] } },
    { "name": "Batch 7 — days until every calendar date", "releasedOn": null,
      "add": { "days-until": ["all-dates"] } }
  ]
}
