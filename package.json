{
  "name": "timewise",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/postbuild.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "check-links": "node scripts/check-links.mjs",
    "count-pages": "node scripts/count-pages.mjs",
