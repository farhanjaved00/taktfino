    "articles:dry": "node scripts/generate-articles.mjs --dry-run",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "astro": "^7.4.12",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
