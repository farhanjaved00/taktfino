    "@fontsource/space-grotesk": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.20.5",
    "satori": "^0.63.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
