# Live URL, no trailing slash (canonical, hreflang, sitemaps, OG)
SITE_URL=https://www.example.com

# Google AdSense publisher ID (ca-pub-…). Empty = no ads, no ad code.
PUBLIC_ADSENSE_CLIENT=
PUBLIC_AD_SLOT_LEADERBOARD=
PUBLIC_AD_SLOT_RECTANGLE=
PUBLIC_AD_SLOT_SKYSCRAPER=
PUBLIC_AD_SLOT_MOBILE=

# Google Analytics 4 (G-XXXX) – runs with Consent Mode v2, denied by default
PUBLIC_GA4_ID=
# Cloudflare Web Analytics token (cookieless)
PUBLIC_CF_ANALYTICS_TOKEN=

# Search engine verification (content of the meta tag only)
PUBLIC_GSC_VERIFICATION=
PUBLIC_BING_VERIFICATION=

# IndexNow key (32 hex chars); same value as GitHub secret INDEXNOW_KEY
INDEXNOW_KEY=

# Article drafts (GitHub secrets in production)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
