# Public site URL (no trailing slash). Used for canonicals, sitemaps, OG tags.
SITE_URL=https://www.example.com

# Google AdSense publisher ID, e.g. ca-pub-1234567890123456. Leave empty = ads OFF.
PUBLIC_ADSENSE_CLIENT=
# Optional AdSense slot IDs per format (leave empty to use auto ads in each slot)
PUBLIC_AD_SLOT_LEADERBOARD=
PUBLIC_AD_SLOT_RECTANGLE=
PUBLIC_AD_SLOT_SKYSCRAPER=
PUBLIC_AD_SLOT_MOBILE=

# Google Search Console verification token (content of the meta tag only)
PUBLIC_GSC_VERIFICATION=

# Article automation (GitHub Actions secrets, not needed locally unless you run `npm run articles`)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
